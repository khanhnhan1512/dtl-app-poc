# DTL mTLS test lab (macOS/Apache) - mirrors lab/nginx/mtls.conf's three ports and five
# curl-testable behaviors exactly (podman can't run on this hardware, no nested virtualization -
# this is the macOS substitute for the Linux nginx container). Both configs must produce the same
# five outcomes below. After changing either config, re-run the five curl checks in the "Check the
# endpoints" section of docs/setup-guide.md and docs/setup-guide-macos.md against BOTH platforms -
# those sections are the executable, actually-shipped form of this contract. (There is background
# rationale in an internal planning doc, but it's git-ignored and not available to most readers -
# the two setup guides are the real source of truth.)
#
#   Port              | Behavior
#   :8443 valid cert  | 200
#   :8443 no cert     | 400
#   :8445 wrong CN    | 403
#   :8444 no cert     | 200
#   :8444 /kill       | serves JSON
#
#   :8443  mandatory client cert  -> 200 with cert / 400 without (tool-1)
#   :8445  mandatory client cert + CN gate -> 403 (this device's CN is never on the approved list;
#          one direction only, no toggle - matches lab/nginx/mtls.conf's tool-2 exactly)
#   :8444  optional client cert -> 200 either way; /kill serves the live signed kill-command JSON
#          straight from lab/kill/kill-command.json (same file the Linux nginx bind-mount points
#          at - no separate copy)
#
# __REPO_ROOT__ is a placeholder, substituted by lab/setup-macos.sh at generation time into the
# git-ignored lab/.apache-runtime/httpd.conf. This file is committed as a template - do not
# hand-edit paths here expecting them to work on any real machine; see lab/setup-macos.sh for the
# substitution mechanism.
#
# :8443's "optional + RewriteCond %{SSL:...} + [R=400,L]" shape (instead of a simpler
# "SSLVerifyClient require") is deliberate, not stylistic, and took two attempts plus a debug
# header to get right. mod_rewrite evaluates BEFORE mod_ssl finishes populating the standard
# subprocess environment table, so a bare %{SSL_CLIENT_VERIFY} - even with SSLOptions +StdEnvVars
# set - silently reads the WRONG value inside RewriteCond specifically (confirmed with a debug
# `Header set X-Debug "%{SSL_CLIENT_VERIFY}e"` directive: mod_headers evaluates later and saw the
# correct value, RewriteCond did not). The %{SSL:varname} form forces a live read from mod_ssl
# directly and is mandatory here, not optional syntax. :8445's SSLRequire does NOT have this
# problem, only RewriteCond does. DO NOT "clean this up" to a bare %{SSL_CLIENT_VERIFY} - it will
# silently break, passing when it should reject.

ServerRoot "__REPO_ROOT__/lab/apache"
ServerName localhost

Listen 8443
Listen 8444
Listen 8445

LoadModule mpm_prefork_module    /usr/libexec/apache2/mod_mpm_prefork.so
LoadModule unixd_module          /usr/libexec/apache2/mod_unixd.so
LoadModule authz_core_module     /usr/libexec/apache2/mod_authz_core.so
LoadModule authz_host_module     /usr/libexec/apache2/mod_authz_host.so
LoadModule mime_module           /usr/libexec/apache2/mod_mime.so
LoadModule log_config_module     /usr/libexec/apache2/mod_log_config.so
LoadModule dir_module            /usr/libexec/apache2/mod_dir.so
LoadModule alias_module          /usr/libexec/apache2/mod_alias.so
LoadModule headers_module        /usr/libexec/apache2/mod_headers.so
LoadModule ssl_module            /usr/libexec/apache2/mod_ssl.so
LoadModule rewrite_module        /usr/libexec/apache2/mod_rewrite.so
LoadModule include_module        /usr/libexec/apache2/mod_include.so
LoadModule negotiation_module     /usr/libexec/apache2/mod_negotiation.so

# PidFile/Mutex/logs must all live under a directory the invoking user owns (NOT
# /private/var/run) - that's what makes this runnable with no sudo. No User/Group directive
# anywhere in this file, deliberately - specifying one is what would force a root-owned
# privilege-drop; omitting it just runs everything as whoever started httpd.
PidFile  "__REPO_ROOT__/lab/.apache-runtime/httpd.pid"
Mutex file:__REPO_ROOT__/lab/.apache-runtime default
ErrorLog "__REPO_ROOT__/lab/.apache-runtime/error.log"
LogLevel warn
LogFormat "%h %t \"%r\" %>s" combined
CustomLog "__REPO_ROOT__/lab/.apache-runtime/access.log" combined

TypesConfig /etc/apache2/mime.types
DirectoryIndex index.html

# SSI, so the served pages can substitute SSL_CLIENT_VERIFY/SSL_CLIENT_S_DN the same way nginx's
# $ssl_client_verify/$ssl_client_s_dn do - real dynamic parity with lab/nginx/mtls.conf, not a
# static approximation of it. Each vhost's own <Directory> block below also needs
# "Options +Includes" and "SSLOptions +StdEnvVars" for this to actually see the SSL variables.
AddOutputFilter INCLUDES .html

SSLRandomSeed startup builtin
SSLRandomSeed connect builtin

# :8443 - tool-1. optional + SSLRequire-via-RewriteCond so the handshake always completes and
# the app gets a real HTTP status (400) instead of a TLS-layer failure with no HTTP response at
# all (the failure mode that would otherwise leave the app on a blank screen).
<VirtualHost *:8443>
  SSLEngine on
  SSLCertificateFile    "__REPO_ROOT__/lab/certs/server.crt"
  SSLCertificateKeyFile "__REPO_ROOT__/lab/certs/server.key"
  SSLCACertificateFile  "__REPO_ROOT__/lab/certs/ca.pem"
  SSLVerifyClient optional
  SSLVerifyDepth 1
  DocumentRoot "__REPO_ROOT__/lab/apache/www8443"
  <Directory "__REPO_ROOT__/lab/apache/www8443">
    SSLOptions +StdEnvVars
    # +MultiViews: nginx's `location /nav` is a pure in-memory string response, matched by URI
    # alone, no filesystem involved. Apache has no equivalent - it needs the extensionless /nav
    # request to resolve to the real nav.html file on disk. MultiViews is the standard Apache
    # mechanism for exactly this (confirmed necessary - /nav 404'd without it).
    Options +Includes +MultiViews
    RewriteEngine On
    RewriteCond %{SSL:SSL_CLIENT_VERIFY} !=SUCCESS
    RewriteRule ^ - [R=400,L]
  </Directory>
</VirtualHost>

# :8445 - tool-2. mandatory client cert + CN gate; cert IS accepted at the TLS layer but the
# approved-CN check always rejects this device with 403 (CN=DTL-Approved-Device never matches the
# provisioned DTL-Ubuntu-Test-Device cert - matches nginx's one-direction-only design exactly).
<VirtualHost *:8445>
  SSLEngine on
  SSLCertificateFile    "__REPO_ROOT__/lab/certs/server.crt"
  SSLCertificateKeyFile "__REPO_ROOT__/lab/certs/server.key"
  SSLCACertificateFile  "__REPO_ROOT__/lab/certs/ca.pem"
  SSLVerifyClient require
  SSLVerifyDepth 1
  DocumentRoot "__REPO_ROOT__/lab/apache/www8445"
  <Directory "__REPO_ROOT__/lab/apache/www8445">
    SSLOptions +StdEnvVars
    Options +Includes
    ForceType text/plain
    SSLRequire %{SSL_CLIENT_S_DN_CN} eq "DTL-Approved-Device"
  </Directory>
</VirtualHost>

# :8444 - kill-switch control plane. Optional client cert (none required). /kill serves the live
# signed command straight from lab/kill/kill-command.json - the same file the Linux nginx
# bind-mount points at, not a separate copy, so both platforms are always looking at the same
# kill state.
<VirtualHost *:8444>
  SSLEngine on
  SSLCertificateFile    "__REPO_ROOT__/lab/certs/server.crt"
  SSLCertificateKeyFile "__REPO_ROOT__/lab/certs/server.key"
  SSLCACertificateFile  "__REPO_ROOT__/lab/certs/ca.pem"
  SSLVerifyClient optional
  DocumentRoot "__REPO_ROOT__/lab/apache/www8444"
  <Directory "__REPO_ROOT__/lab/apache/www8444">
    SSLOptions +StdEnvVars
    Options +Includes
    ForceType text/plain
  </Directory>
  Alias /kill "__REPO_ROOT__/lab/kill/kill-command.json"
  <Location "/kill">
    ForceType application/json
    Header set Cache-Control no-store
  </Location>
</VirtualHost>
